# Copy to .env.local for dev, or set on Vercel for prod.
# Base URL of the Laravel API (no trailing slash, no /api suffix).
VITE_API_BASE=http://localhost:8000

# CARTO basemap API key. CARTO enforces keys on basemaps.cartocdn.com since
# Aug 2026 (anonymous tiles are watermarked "API KEY REQUIRED"). Free, no
# account: https://carto.com/basemaps/apikey/ . Leave unset to fall back to
# keyless OpenStreetMap tiles (light style; dark mode inverts them via CSS).
VITE_CARTO_API_KEY=
